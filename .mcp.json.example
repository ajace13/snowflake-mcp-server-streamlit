{
  "mcpServers": {
    "sakila-warehouse": {
      "type": "stdio",
      "command": "C:/path/to/snowflake-mcp-server-streamlit/.venv/Scripts/python.exe",
      "args": [
        "C:/path/to/snowflake-mcp-server-streamlit/mcp_server.py"
      ],
      "env": {
        "SNOWFLAKE_CONFIG_FILE": "C:/Users/<your-user>/AppData/Local/snowflake/config.toml",
        "SNOWFLAKE_CONNECTION": "claude",
        "SNOWFLAKE_ROLE": "A5_APP_RO"
      }
    }
  }
}
